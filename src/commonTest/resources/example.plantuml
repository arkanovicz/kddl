@startuml
'' Database geo
package infra {
  class zone {
    {field} type urban|rural|industrial
    {field} **code** varchar(10)
    {field} name varchar(50)
    {field} //description text//
    {field} active boolean
  }

  class department
  department --|> zone

  class city {
    {field} //hasTrain boolean//
    {field} departmentCode varchar(10)
  }
  city --|> zone

  class link {
    {field} distance integer
    {field} **src_id** varchar(10)
    {field} **dst_id** varchar(10)
    {field} //hub_id varchar(10)//
  }
}

package client {
  class contact {
    {field} //gender char//
    {field} firstname varchar(200)
    {field} lastname varchar(200)
    --
    {field} !(firstname, lastname)
  }

  class location {
    {field} name varchar(50)
    {field} nature depart|arrival
    {field} //address text//
  }
}
  city }-up-> department
  link }--> zone
  link }--> zone
  link }.down.> zone
  location }--> contact
  location }--> zone : code
 hide methods
@enduml
